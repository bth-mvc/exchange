# =============================================================================
# Produktion (kommentera in på server, kommentera ut vid lokal utveckling)
# =============================================================================
PORT=4000
API_KEY_SERVER_URL=https://api.example.com
SERVICE_TOKEN=change-this-to-a-long-random-string
KEY_CACHE_TTL_MS=86400000
DB_PATH=./data/exchange.db
NODE_ENV=production
DOMAIN=exchange.example.com

# =============================================================================
# Dev (kommentera in vid lokal utveckling)
# =============================================================================
# NODE_ENV=development
# API_KEY_SERVER_URL=http://localhost:5000
# SERVICE_TOKEN=dev-service-token-at-least-16
# DOMAIN=localhost
# DEV_API_KEY=dev-local-key   # hoppar över api-server-verifiering för denna nyckel

# =============================================================================
# TUI (npm run tui)
# =============================================================================
# EXCHANGE_URL=http://localhost:4000
# API_KEY=dev-local-key
