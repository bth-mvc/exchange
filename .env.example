# Lokal utveckling — kopiera till .env och justera
NODE_ENV=development
PORT=4001
API_KEY_SERVER_URL=http://localhost:5000
SERVICE_TOKEN=dev-service-token-at-least-16
DOMAIN=localhost
DEV_API_KEY=dev-local-key

# DOCKER — valfritt, ändra om port 80/443 är upptagna
# HTTP_PORT=8082
# HTTPS_PORT=8442
# CADDYFILE=Caddyfile.local   # self-signed cert för lokal HTTPS-testning

# TUI (npm run tui)
EXCHANGE_URL=http://localhost:4001
API_KEY=dev-local-key
